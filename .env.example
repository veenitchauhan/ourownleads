APP_URL=https://ourownleads.test
LOCAL_DEVELOPMENT=true
# Local database. Keep data/ private and backed up.
CRM_DB_PATH=data/our-own-leads.sqlite
# Required for deployment: 32 random bytes encoded as 64 hex characters.
CREDENTIAL_ENCRYPTION_KEY=
META_GRAPH_VERSION=v25.0
META_APP_SECRET=
META_VERIFY_TOKEN=
# Comma-separated immutable user IDs. Never grant administrator access by signup email.
PLATFORM_ADMIN_USER_IDS=
# Optional initial platform configuration; the admin UI stores overrides encrypted.
META_APP_ID=
META_SIGNUP_CONFIG_ID=
META_ONBOARDING_ENABLED=false

# Superadmin signs in with username admin. Set a strong password server-side.
ADMIN_PASSWORD=
